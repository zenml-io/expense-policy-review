# Synthetic demo credentials. Do not commit a filled-in .env.
OPENAI_API_KEY=
# Chat model. The agent prefixes openai: when the value has no provider.
OPENAI_MODEL=gpt-5-nano

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
# The installed SDK prefers LANGFUSE_BASE_URL when that variable is set,
# and otherwise reads LANGFUSE_HOST.
LANGFUSE_HOST=https://cloud.langfuse.com
